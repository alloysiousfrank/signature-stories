# Copy to .env (never commit .env)
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/signature-stories?retryWrites=true&w=majority
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed website origins
CLIENT_ORIGINS=http://localhost:5173,https://your-site.vercel.app
# Optional e-mail alert on every new enquiry (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=bengalisongaf@gmail.com
MAIL_FROM=Signature Stories <onboarding@resend.dev>
# Only used by `npm run seed:admin`
ADMIN_EMAIL=bengalisongaf@gmail.com
ADMIN_PASSWORD=
