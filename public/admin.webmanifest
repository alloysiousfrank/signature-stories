{
  "name": "Signature Stories Admin",
  "short_name": "SS Admin",
  "description": "Enquiries, quotations, invoices, calendar and reports for Signature Stories.",
  "id": "/#/admin",
  "start_url": "/#/admin/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f0df",
  "theme_color": "#d0cbb0",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Enquiries", "url": "/#/admin/inquiries" },
    { "name": "New invoice", "url": "/#/admin/invoices?new=1" },
    { "name": "Calendar", "url": "/#/admin/calendar" }
  ]
}
